# =============================================================================
# FRONT (Vite) — tudo aqui VAI PARAR NO BUNDLE PUBLICO.
# Nunca coloque token de HubSpot, service_role key ou qualquer segredo aqui.
# =============================================================================

# Painel Supabase > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Link de agendamento round-robin do HubSpot (revezamento de qualificacao).
# Cada evento pode sobrescrever isso na coluna `eventos.link_agendamento`.
VITE_LINK_AGENDAMENTO_ROUND_ROBIN=https://meetings.hubspot.com/nicholas-love/revezamento-de-qualificacao-

# =============================================================================
# EDGE FUNCTION `sync-lead` — segredos do backend.
# NAO vao para o .env do front. Suba com:
#   supabase secrets set --env-file supabase/.env.local
# =============================================================================

# Private App token do HubSpot.
# HubSpot > Configuracoes > Integracoes > Apps privados > Criar app privado.
# Scopes necessarios:
#   crm.objects.contacts.read   crm.objects.contacts.write
#   crm.objects.companies.read  crm.objects.companies.write
#   crm.objects.deals.read      crm.objects.deals.write
#   crm.objects.owners.read     crm.schemas.deals.read
HUBSPOT_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---- Configuracao de negocio no HubSpot -------------------------------------
# Os valores abaixo ja vem preenchidos com o que existe hoje no portal 22634045
# da Revi. Confira antes do primeiro evento e troque quando o processo mudar.

# Pipeline "Vendas Diretas"
HUBSPOT_PIPELINE_ID=139031732

# Etapa inicial do negocio, no pipeline Vendas Diretas.
#   238830452 = Qualificacao      <- lead de evento entra aqui
#   238830451 = Contato
#   238830450 = Prospect/Pesquisa
#   972200814 = Discovery Call    <- so por workflow, quando a reuniao e marcada
HUBSPOT_DEAL_STAGE_INICIAL_ID=238830452

# Canal do lead (enum no negocio). Valor interno exato: "Eventos".
HUBSPOT_PROPERTY_CANAL=canal_de_lead
HUBSPOT_VALOR_CANAL=Eventos

# Detalhamento de origem. CUIDADO: existem DUAS properties parecidas no negocio.
#   detalhamento_de_origem            -> texto livre, aceita qualquer valor
#   detalhamento_de_origem_do_negocio -> DROPDOWN, so aceita opcao existente
# O app preenche as duas, com o valor de `eventos.valor_detalhamento_origem`.
# O dropdown exige que o evento exista como opcao em Configuracoes >
# Propriedades > Negocio. Se nao existir, o app grava so a de texto livre e
# registra o aviso no log — o lead nao falha por causa disso.
HUBSPOT_PROPERTY_DETALHAMENTO_ORIGEM=detalhamento_de_origem
HUBSPOT_PROPERTY_DETALHAMENTO_ORIGEM_NEGOCIO=detalhamento_de_origem_do_negocio

# BDR responsavel (enum cujos valores sao HubSpot owner IDs).
HUBSPOT_PROPERTY_BDR_RESPONSAVEL=bdr_responsavel

# Origem do negocio (enum). Deixe vazio para nao preencher.
HUBSPOT_PROPERTY_ORIGEM_NEGOCIO=origem_do_negocio
HUBSPOT_VALOR_ORIGEM_NEGOCIO=Venda Direta

# Plataforma de e-commerce (enum no negocio). Deixe vazio para nao preencher —
# nesse caso a plataforma ainda aparece na nota do negocio.
HUBSPOT_PROPERTY_PLATAFORMA=plataforma_de_e_commerce_utilizada

# ---- Espelho no negocio -----------------------------------------------------
# Quem e o lead, no proprio negocio, para o closer nao precisar abrir o contato.
# As duas properties abaixo ja existem no portal e sao texto livre.
# Nao aponte para `cargo_do_lead`: e um enum legado de 8 opcoes fixas.
HUBSPOT_PROPERTY_NOME_LEAD=nome_do_lead
HUBSPOT_PROPERTY_CARGO_LEAD=lead_cargo

# ---- Instagram na empresa ---------------------------------------------------
# O @ da loja vai para a EMPRESA. O site tambem (campo padrao `website`), e o
# telefone e o e-mail vao para o CONTATO nos campos padrao — nao precisam de
# configuracao. Nao confunda com `instagram_followers`, que e numerico.
HUBSPOT_PROPERTY_INSTAGRAM_EMPRESA=instagram

# ⚠️ PREENCHER — property de TEXTO no negocio usada como chave de idempotencia.
# Nao existe ainda no portal; crie em HubSpot > Configuracoes > Propriedades >
# Negocio > Criar propriedade (tipo: texto de linha unica, ex. `id_captura_evento`).
# Se ficar vazio, a idempotencia continua garantida pela tabela de controle no
# Supabase; a property e apenas a segunda barreira.
HUBSPOT_PROPERTY_ID_CAPTURA=

# ---- Injetados automaticamente pelo Supabase nas Edge Functions -------------
# Nao precisa definir manualmente em producao.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
